<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="#F2F2F2"
                android:textSize="40sp"
                android:fontFamily="sans-serif"
        android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d בMMMM"
                android:format24Hour="EEEE, d בMMMM"
                android:textColor="#F2F2F2"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● מוגן"
            android:textColor="#30D158"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- התרעה פעילה (אדום/כתום/ירוק): אייקון, כותרת, שורה מתחתיה, מיקום, ובאדום גם ספירה -->
    <LinearLayout
        android:id="@+id/wl_pre_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pre_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/wl_pre_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_list_pre" />

        <TextView
            android:id="@+id/wl_pre_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מבזק פיקוד העורף"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wl_pre_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="התרעה מקדימה"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wl_pre_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/wl_pre_cd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
