<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:padding="12dp">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm:ss"
        android:format24Hour="HH:mm:ss"
        android:textColor="#F2F2F2"
        android:textSize="30sp"
        android:fontFamily="sans-serif"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● מוגן"
        android:textColor="#30D158"
        android:textSize="14sp" />

    <!-- התרעה מקדימה פעילה: אייקון, מבזק, התרעה מקדימה, מיקום -->
    <LinearLayout
        android:id="@+id/widget_pre_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pre_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_pre_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_list_pre" />

        <TextView
            android:id="@+id/widget_pre_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מבזק פיקוד העורף"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pre_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="התרעה מקדימה"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_pre_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="אין התראות עדיין"
        android:textColor="#8E8E93"
        android:textSize="12sp" />
</LinearLayout>
